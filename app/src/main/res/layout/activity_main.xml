<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#101827">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TechZone"
        android:textSize="38sp"
        android:textStyle="bold"
        android:textColor="#60A5FA"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bienvenido a TechZone"
        android:textSize="23sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Regístrate y descubre información sobre tecnología, hardware y las últimas tendencias."
        android:textSize="16sp"
        android:textColor="#CBD5E1"
        android:gravity="center"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnComenzar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Comenzar"
        android:textAllCaps="false"
        android:textSize="18sp"
        android:backgroundTint="#2563EB"
        android:textColor="#FFFFFF" />

</LinearLayout>
